import{useEffect,useState}from'react';import{createRoot}from'react-dom/client';import{jsPDF}from'jspdf';import*as at from'jspdf-autotable';import{FileText,History,Package,Users,Settings,LogOut,Eye,Download,Share2}from'lucide-react';import type{Buyer,Product,Quotation}from'./types';import'./styles.css';const table=(at as any).default,fmt=(n:number)=>new Intl.NumberFormat('en-LK',{style:'currency',currency:'LKR'}).format(n/100);let csrf='';async function api<T>(u:string,o:RequestInit={}):Promise<T>{const r=await fetch(u,{...o,headers:{'Content-Type':'application/json','X-CSRF-Token':csrf,...o.headers}});if(!r.ok){const b=await r.json().catch(()=>({}));throw Error((b as any).error||`Request failed (${r.status})`)}return r.status===204?undefined as T:r.json()}
function PDF({q}:{q:Quotation}){const[info,setInfo]=useState('');const run=async(a:string)=>{const w=a==='preview'?window.open('','_blank'):null;try{const d=new jsPDF();d.setFontSize(18);d.text(q.shop_name,14,18);d.setFontSize(20);d.text('QUOTATION',196,18,{align:'right'});d.setFontSize(9);d.text(`${q.quotation_number}\n${q.buyer_name}\n${q.buyer_phone}`,14,30);table(d,{startY:52,head:[['Item','Description','Qty','Price','Total']],body:q.items.map(i=>[i.item_name,i.sku,i.quantity,fmt(i.unit_price_minor),fmt(i.row_total_minor)]),foot:[['','','','','Total '+fmt(q.total_minor)]],theme:'grid',headStyles:{fillColor:[16,42,67]}});const b=d.output('blob'),u=URL.createObjectURL(b),n=`${q.quotation_number}.pdf`,f=new File([b],n,{type:'application/pdf'});if(a==='preview'){if(w)w.location.href=u;else setInfo('Preview blocked. Download the PDF instead.')}if(a==='download'){const x=document.createElement('a');x.href=u;x.download=n;x.click()}if(a==='share'&&navigator.canShare?.({files:[f]}))await navigator.share({files:[f]});else if(a==='share')setInfo('Sharing unavailable. Download the PDF to attach it manually.')}catch(e){if(w)w.close();setInfo((e as Error).message)}};return <div className="pdf-actions"><button onClick={()=>run('preview')}><Eye/> Preview</button><button onClick={()=>run('download')}><Download/> Download</button><button onClick={()=>run('share')}><Share2/> Share</button>{info&&<p>{info}</p>}</div>}
function App(){const[ok,setOk]=useState(false),[page,setPage]=useState('quote'),[bs,setBs]=useState<Buyer[]>([]),[ps,setPs]=useState<Product[]>([]),[b,setB]=useState<Buyer|null>(null),[its,setIts]=useState<{p:Product;q:number}[]>([]),[saved,setSaved]=useState<Quotation|null>(null),[history,setHistory]=useState<any[]>([]),[settings,setSettings]=useState<any>(null),[err,setErr]=useState('');useEffect(()=>{api<any>('/api/session').then(s=>{csrf=s.csrfToken;setOk(true);return Promise.all([api<Buyer[]>('/api/buyers'),api<Product[]>('/api/products'),api<any>('/api/settings'),api<any[]>('/api/quotations')])}).then(([x,y,z,h])=>{setBs(x);setPs(y);setSettings(z);setHistory(h)}).catch(()=>setOk(false))},[]);if(!ok)return <Login/>;const total=its.reduce((n,i)=>n+i.p.price_minor*i.q,0);const save=async()=>{if(!b||!its.length)return setErr('Choose a buyer and at least one product.');try{const q=await api<Quotation>('/api/quotations',{method:'POST',body:JSON.stringify({idempotencyKey:crypto.randomUUID(),buyerId:b.id,quotationDate:new Date().toISOString().slice(0,10),items:its.map(i=>({productId:i.p.id,quantity:i.q}))})});setSaved(q);setHistory([q,...history])}catch(e){setErr((e as Error).message)}};return <div className="app-shell"><header className="topbar"><b>RICH TIME</b><button onClick={()=>api('/api/logout',{method:'POST'}).then(()=>location.reload())}><LogOut/></button></header><main className="app-main">{page==='quote'&&<section className="quote-page"><h1>New quotation</h1><label>Buyer<select onChange={e=>setB(bs.find(x=>x.id===+e.target.value)||null)}><option>Select buyer</option>{bs.map(x=><option value={x.id} key={x.id}>{x.full_name} · {x.phone}</option>)}</select></label><h2>Products</h2>{ps.map(p=><button className="product-row" onClick={()=>setIts(x=>x.some(i=>i.p.id===p.id)?x.map(i=>i.p.id===p.id?{...i,q:i.q+1}:i):[...x,{p,q:1}])} key={p.id}>{p.brand} {p.model_name}<b>{fmt(p.price_minor)}</b></button>)}<h2>Items</h2>{its.map(i=><div className="review-line" key={i.p.id}>{i.p.brand} {i.p.model_name}<input type="number" value={i.q} onChange={e=>setIts(its.map(x=>x.p.id===i.p.id?{...x,q:+e.target.value||1}:x))}/><b>{fmt(i.p.price_minor*i.q)}</b></div>)}<div className="quote-total"><span>Total</span><strong>{fmt(total)}</strong><button className="primary" onClick={save}>Review & save</button></div>{err&&<p className="error">{err}</p>}</section>}{page==='history'&&<section className="list-page"><h1>History</h1>{history.map(h=><article className="history-card" key={h.id}><span>{h.buyer_name}<small>{h.quotation_number} · {h.quotation_date}</small></span><b>{fmt(h.total_minor)}</b><button onClick={()=>api<Quotation>(`/api/quotations/${h.id}`).then(setSaved)}>Open</button></article>)}</section>}{page==='products'&&<section className="list-page"><h1>Products</h1>{ps.map(p=><article className="history-card" key={p.id}>{p.brand} {p.model_name}<b>{fmt(p.price_minor)}</b></article>)}</section>}{page==='buyers'&&<section className="list-page"><h1>Buyers</h1>{bs.map(x=><article className="history-card" key={x.id}>{x.full_name}<b>{x.phone}</b></article>)}</section>}{page==='settings'&&settings&&<section className="list-page"><h1>Settings</h1><label>Shop name<input value={settings.shop_name} onChange={e=>setSettings({...settings,shop_name:e.target.value})}/></label><label>Phone<input value={settings.phone} onChange={e=>setSettings({...settings,phone:e.target.value})}/></label><button className="primary" onClick={()=>api('/api/settings',{method:'PUT',body:JSON.stringify(settings)})}>Save settings</button></section>}{saved&&<div className="modal-backdrop"><section className="quote-dialog"><h1>{saved.quotation_number}</h1><p>{saved.buyer_name} · {fmt(saved.total_minor)}</p><PDF q={saved}/><button onClick={()=>setSaved(null)}>Close</button></section></div>}</main><nav className="bottom-nav">{[['quote','New Quote',FileText],['history','History',History],['products','Products',Package],['buyers','Buyers',Users],['settings','Settings',Settings]].map(([id,l,I]:any)=><button className={page===id?'active':''} onClick={()=>setPage(id)} key={id}><I/><span>{l}</span></button>)}</nav></div>}
function Login(){const[u,setU]=useState(''),[p,setP]=useState(''),[e,setE]=useState('');return <main className="login-page"><section className="login-card"><h1>Rich Time</h1><form onSubmit={async x=>{x.preventDefault();try{await api('/api/login',{method:'POST',body:JSON.stringify({username:u,password:p})});location.reload()}catch(x){setE((x as Error).message)}}}><input placeholder="Username" value={u} onChange={x=>setU(x.target.value)}/><input type="password" placeholder="Password" value={p} onChange={x=>setP(x.target.value)}/><button className="primary full">Sign in</button>{e&&<p className="error">{e}</p>}</form></section></main>}createRoot(document.getElementById('root')!).render(<App/>);
